{
  "name": "r2provisioning",
  "version": "0.0.2",
  "description": "Device provisioning library for ESP32 and ESP8266",
  "keywords": ["provisioning", "esp32", "esp8266", "iot"],
  "repository": {
    "type": "git",
    "url": "https://github.com/TordWessman/r2provisioning.git"
  },
  "authors": [{ "name": "Olga" }],
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["espressif32", "espressif8266"],
  "build": {
    "srcDir": "r2provisioning/src",
    "includeDir": "r2provisioning/src",
    "srcFilter": [
      "+<r2provisioning/>",
      "+<r2Common/lib/r2common/src/>"
    ],
    "flags": [
      "-Ir2provisioning/src",
      "-Ir2provisioning/src/r2Common/lib/r2common/src",
      "-Ir2provisioning/src/r2Common/lib/r2common/src/Network"
    ]
  },
  "export": {
    "exclude": [
      "client-sdks/",
      "r2provisioning/test/",
      "r2provisioning/examples/",
      "r2provisioning/src/r2Common/examples/",
      "r2provisioning/src/r2Common/src/",
      "r2provisioning/src/r2Common/test/",
      ".vscode/",
      ".pio/"
    ]
  }
}
